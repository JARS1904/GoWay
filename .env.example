# =========================================================
# GoWay - Archivo de configuración de variables (.env)
# =========================================================
# Instrucciones en Hostinger:
# 1. Copia este archivo como ".env" en la raíz o preferiblemente 1 nivel arriba de public_html.
# 2. Reemplaza los valores con las credenciales reales de tu servidor MySQL.
# =========================================================

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=goway
DB_PORT=3306

# Configuración adicional de entorno (opcional)
APP_ENV=production
APP_URL=https://tusitio.com
